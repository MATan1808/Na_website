<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_wbh" model="res.groups.privilege">
        <field name="name">WBH Multi-Store</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <record id="group_wbh_catalog_user" model="res.groups">
        <field name="name">Nhân viên Catalog &amp; Vận hành WBH</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_wbh"/>
        <field name="implied_ids" eval="[
            Command.link(ref('sales_team.group_sale_salesman')),
            Command.link(ref('stock.group_stock_user')),
        ]"/>
        <field name="comment">Cho phép đăng sản phẩm, quản lý danh mục website, giá trị thuộc tính và vận hành đơn hàng trên 2 cửa hàng WBH.</field>
    </record>

    <record id="group_wbh_manager" model="res.groups">
        <field name="name">Quản trị 2 Cửa Hàng WBH</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_wbh"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_wbh_catalog_user')),
            Command.link(ref('website.group_website_designer')),
            Command.link(ref('sales_team.group_sale_manager')),
        ]"/>
        <field name="user_ids" eval="[
            Command.link(ref('base.user_root')),
            Command.link(ref('base.user_admin')),
        ]"/>
        <field name="comment">Toàn quyền cấu hình 2 website Quà tặng &amp; Thời trang, danh mục, thuộc tính và quản trị bán hàng.</field>
    </record>

    <data noupdate="1">
        <!--
            Tắt rule public mặc định của website_sale (không lọc website_id) để thay bằng
            rule cô lập chặt theo website_id và allowed_company_ids.
            Rule gốc sẽ được bật lại tự động trong uninstall_hook khi gỡ wbh_core.
        -->
        <record id="website_sale.product_template_public" model="ir.rule">
            <field name="active" eval="False"/>
        </record>

        <record id="wbh_product_template_public_rule" model="ir.rule">
            <field name="name">WBH: Public/Portal chỉ xem sản phẩm đã đăng bán đúng Website &amp; Công ty</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="domain_force">[
                ('is_published', '=', True),
                ('sale_ok', '=', True),
                '|', ('website_id', '=', False), ('website_id', '=', website.id),
                '|', ('company_id', '=', False), ('company_id', 'in', company_ids + ([website.company_id.id] if website and website.company_id else [])),
            ]</field>
            <field name="groups" eval="[
                Command.link(ref('base.group_public')),
                Command.link(ref('base.group_portal')),
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
