<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form sản phẩm: Chèn nhóm "Thông tin Đăng bán WBH" ngay trong General Information -->
    <record id="wbh_product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.wbh_core</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//group[@name='internal_notes']" position="before">
                <group name="wbh_store_info" string="Thông tin Đăng bán WBH" invisible="not sale_ok">
                    <group name="wbh_store_info_left">
                        <field name="wbh_store_scope"/>
                        <field name="website_id"
                               readonly="wbh_store_scope != 'both'"
                               force_save="1"
                               options="{'no_create': True}"
                               placeholder="Hiển thị trên cả 2 Website"/>
                        <field name="public_categ_ids"
                               widget="many2many_tags"
                               string="Danh mục Website"
                               options="{'no_create_edit': True}"/>
                        <field name="is_published" widget="boolean_toggle"/>
                    </group>
                    <group name="wbh_store_info_right">
                        <field name="wbh_short_highlight"
                               placeholder="VD: Bông PP siêu mềm, tặng kèm túi rút / Cotton 250gsm thoáng mát"/>
                        <field name="wbh_care_note"
                               placeholder="Hướng dẫn giặt, bảo quản hoặc lưu ý sử dụng..."/>
                        <field name="wbh_low_stock_threshold"/>
                        <field name="wbh_is_low_stock" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- List View sản phẩm chung: thêm badge Cửa hàng & trạng thái Sắp hết hàng -->
    <record id="wbh_product_template_list_view" model="ir.ui.view">
        <field name="name">product.template.list.inherit.wbh_core</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="wbh_store_scope"
                       widget="badge"
                       decoration-info="wbh_store_scope == 'gift'"
                       decoration-primary="wbh_store_scope == 'fashion'"
                       decoration-success="wbh_store_scope == 'both'"
                       optional="show"/>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="wbh_is_low_stock" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- List View eCommerce: bật boolean_toggle cho is_published và hiện sẵn website_id -->
    <record id="wbh_product_template_website_sale_list_view" model="ir.ui.view">
        <field name="name">product.template.website_sale.list.inherit.wbh_core</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_view_tree_website_sale"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='is_published']" position="attributes">
                <attribute name="widget">boolean_toggle</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

    <!-- Search View sản phẩm: Bộ lọc nhanh Web 1 / Web 2 / Đăng bán / Sắp hết hàng & Group By -->
    <record id="wbh_product_template_search_view" model="ir.ui.view">
        <field name="name">product.template.search.inherit.wbh_core</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='favorites']" position="after">
                <separator/>
                <filter string="Web 1 — Quà tặng"
                        name="wbh_filter_gift"
                        domain="[('wbh_store_scope', 'in', ('gift', 'both'))]"/>
                <filter string="Web 2 — Thời trang"
                        name="wbh_filter_fashion"
                        domain="[('wbh_store_scope', 'in', ('fashion', 'both'))]"/>
                <separator/>
                <filter string="Đã đăng bán"
                        name="wbh_filter_published"
                        domain="[('is_published', '=', True)]"/>
                <filter string="Chưa đăng bán"
                        name="wbh_filter_unpublished"
                        domain="[('is_published', '=', False)]"/>
                <filter string="Sắp hết hàng"
                        name="wbh_filter_low_stock"
                        domain="[('wbh_is_low_stock', '=', True)]"/>
            </xpath>
            <xpath expr="//filter[@name='group_by_categ_id']" position="after">
                <filter string="Cửa hàng đăng bán (WBH)"
                        name="wbh_group_by_store_scope"
                        context="{'group_by': 'wbh_store_scope'}"/>
                <filter string="Website"
                        name="wbh_group_by_website_id"
                        context="{'group_by': 'website_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Search View cho Danh mục Website để hỗ trợ nhóm sẵn theo Website -->
    <record id="wbh_product_public_category_search_view" model="ir.ui.view">
        <field name="name">product.public.category.search.wbh_core</field>
        <field name="model">product.public.category</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Danh mục Website">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="website_id" groups="website.group_multi_website"/>
                <group>
                    <filter string="Website"
                            name="group_by_website_id"
                            context="{'group_by': 'website_id'}"/>
                    <filter string="Danh mục cha"
                            name="group_by_parent_id"
                            context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Search View cho Đơn hàng eCommerce: bổ sung Group By Website -->
    <record id="wbh_sale_order_ecommerce_search_view" model="ir.ui.view">
        <field name="name">sale.order.ecommerce.search.inherit.wbh_core</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="website_sale.view_sales_order_filter_ecommerce"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='from_website']" position="after">
                <field name="website_id" groups="website.group_multi_website"/>
            </xpath>
            <xpath expr="//search/group" position="inside">
                <filter string="Website"
                        name="wbh_group_by_website_id"
                        context="{'group_by': 'website_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
