<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Tùy biến Trang Shop, Chi Tiết Sản Phẩm & Giỏ Hàng cho Web 1 — Manh Dao Dao (Odoo 19.0 Community).
        Mọi phần tử QWeb chèn thêm đều khóa chặt trong t-if="website and website.wbh_store_type == 'gift'"
        và đọc ngữ cảnh controller qua .get() phòng thủ để tuyệt đối không lỗi nếu thiếu khóa.
    -->

    <!-- 0A. Sub-template: Bộ lọc động 100% (Đang giảm giá, Khoảng giá, Nhãn & Chủ đề) -->
    <template id="gift_dynamic_filters_panel" name="WBH Gift — Bộ lọc động">
        <t t-set="wbh_fctx" t-value="wbh_filter_ctx or {}"/>
        <t t-set="wbh_on_sale" t-value="wbh_fctx.get('on_sale') or {}"/>
        <t t-set="wbh_price_ranges" t-value="wbh_fctx.get('price_ranges') or []"/>
        <t t-set="wbh_tags" t-value="wbh_fctx.get('tags') or []"/>
        <t t-set="wbh_has_sale" t-value="wbh_on_sale.get('count', 0) &gt; 0"/>
        <t t-set="wbh_visible_prices" t-value="[p for p in wbh_price_ranges if p.get('count', 0) &gt; 0]"/>
        <t t-set="wbh_visible_tags" t-value="[tg for tg in wbh_tags if tg.get('count', 0) &gt; 0]"/>

        <div
            t-if="wbh_has_sale or wbh_visible_prices or wbh_visible_tags"
            t-attf-class="wbh-gift-filter-panel {{'wbh-gift-filter-panel--mobile px-3 py-3 border-bottom' if wbh_filter_mobile else 'pb-3 mb-3 border-bottom'}}"
        >
            <!-- Đang giảm giá -->
            <div t-if="wbh_has_sale" class="wbh-gift-filter-group mb-3">
                <a
                    t-att-href="wbh_on_sale.get('toggle_url', '/shop')"
                    t-attf-class="wbh-gift-sale-toggle {{'is-active' if wbh_on_sale.get('active') else ''}}"
                    t-att-aria-pressed="'true' if wbh_on_sale.get('active') else 'false'"
                >
                    <span class="d-inline-flex align-items-center gap-2">
                        <i data-lucide="tag" class="wbh-lucide-icon" aria-hidden="true"/>
                        <span>Đang giảm giá</span>
                    </span>
                    <span class="wbh-gift-filter-count" t-out="wbh_on_sale.get('count', 0)"/>
                </a>
            </div>

            <!-- Khoảng giá động theo website -->
            <div t-if="wbh_visible_prices" class="wbh-gift-filter-group mb-3">
                <h2 class="h6 wbh-gift-filter-heading mb-2">Khoảng giá</h2>
                <div class="d-flex flex-column gap-1">
                    <a
                        t-foreach="wbh_visible_prices"
                        t-as="pr"
                        t-att-href="pr.get('url', '/shop')"
                        t-attf-class="wbh-gift-price-option {{'is-active' if pr.get('active') else ''}}"
                        t-att-aria-current="'true' if pr.get('active') else None"
                    >
                        <span class="wbh-price-label" t-out="pr.get('name')"/>
                        <span class="wbh-gift-filter-count" t-out="pr.get('count', 0)"/>
                    </a>
                </div>
            </div>

            <!-- Nhãn & Chủ đề động từ product.tag -->
            <div t-if="wbh_visible_tags" class="wbh-gift-filter-group">
                <h2 class="h6 wbh-gift-filter-heading mb-2">Nhãn &amp; Chủ đề</h2>
                <div class="d-flex flex-wrap gap-2">
                    <a
                        t-foreach="wbh_visible_tags"
                        t-as="tag"
                        t-att-href="tag.get('toggle_url', '/shop')"
                        t-attf-class="wbh-gift-tag-filter {{'is-active' if tag.get('active') else ''}}"
                        t-att-aria-pressed="'true' if tag.get('active') else 'false'"
                    >
                        <span
                            t-if="tag.get('hex_color')"
                            class="wbh-tag-dot"
                            t-att-data-wbh-dot-color="tag.get('hex_color')"
                            aria-hidden="true"
                        />
                        <span t-out="tag.get('name')"/>
                        <span class="wbh-gift-filter-count" t-out="tag.get('count', 0)"/>
                    </a>
                </div>
            </div>
        </div>
    </template>

    <!-- 0B. Sub-template: Hộp Tư vấn (Chat tại Web · Facebook · Chép link) -->
    <template id="gift_contact_channels_box" name="WBH Gift — Hộp Tư Vấn Shop">
        <t t-set="wbh_can_livechat" t-value="bool(website.wbh_livechat_enabled)"/>
        <t t-set="wbh_fb_url" t-value="website.wbh_support_facebook_url"/>
        <div
            t-attf-class="wbh-gift-support-box {{'wbh-gift-support-box--cart mt-4' if wbh_contact_mode == 'cart' else 'mb-4'}}"
        >
            <div class="d-flex flex-column gap-2">
                <div class="wbh-gift-support-box__header d-flex align-items-center justify-content-between gap-2 flex-wrap">
                    <span class="small fw-semibold d-inline-flex align-items-center gap-2">
                        <i data-lucide="headphones" class="wbh-lucide-icon wbh-gift-icon-accent" aria-hidden="true"/>
                        <span t-out="website.wbh_contact_prompt or 'Cần vid check hoặc tư vấn chọn hàng?'"/>
                    </span>
                </div>
                <div class="wbh-gift-support-box__actions d-flex flex-wrap gap-2">
                    <button
                        t-if="wbh_can_livechat"
                        type="button"
                        class="btn btn-sm wbh-gift-btn-primary wbh-gift-channel-btn"
                        data-wbh-action="livechat"
                        t-att-data-wbh-product-name="wbh_contact_item_title or website.name"
                    >
                        <i data-lucide="message-square" class="wbh-lucide-icon" aria-hidden="true"/>
                        <span>Chat tại Web</span>
                    </button>
                    <a
                        t-if="wbh_fb_url"
                        t-att-href="wbh_fb_url"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-sm wbh-gift-btn-outline wbh-gift-channel-btn"
                    >
                        <i data-lucide="send" class="wbh-lucide-icon" aria-hidden="true"/>
                        <span>Nhắn Facebook</span>
                    </a>
                    <button
                        type="button"
                        class="btn btn-sm wbh-gift-btn-secondary wbh-gift-channel-btn"
                        data-wbh-action="copy-product"
                        t-att-data-wbh-product-name="wbh_contact_item_title or website.name"
                    >
                        <i data-lucide="copy" class="wbh-lucide-icon" aria-hidden="true"/>
                        <span>Chép tên &amp; link SP</span>
                    </button>
                </div>
            </div>
        </div>
    </template>

    <!-- 0C. Sidebar /shop: Chuẩn hóa nhãn 'Loại goods' & ẩn 'Mẫu Thẻ Sưu Tầm' nếu còn tồn tại -->
    <template
        id="gift_attribute_filters_clean"
        inherit_id="website_sale.product_attribute_filters_form"
        name="WBH Gift Store Attribute Filter Labels"
        priority="30"
    >
        <xpath expr="//t[@t-foreach='attributes']/div" position="attributes">
            <attribute
                name="t-attf-class"
                add="{{'d-none' if (website and website.wbh_store_type == 'gift' and a.name and 'mẫu thẻ sưu tầm' in a.name.lower()) else ''}}"
                separator=" "
            />
        </xpath>
        <xpath expr="//t[@t-foreach='attributes']/div//b[@t-out='a.name']" position="replace">
            <b t-if="website and website.wbh_store_type == 'gift' and a.name and a.name.strip().lower() == 'gói phân loại'">Loại goods</b>
            <b t-else="" t-out="a.name"/>
        </xpath>
        <xpath expr="//t[@t-foreach='attributes']/div//b[@t-field='a.name']" position="replace">
            <b
                t-if="website and website.wbh_store_type == 'gift' and a.name and a.name.strip().lower() == 'gói phân loại'"
                class="d-none d-lg-block"
            >Loại goods</b>
            <b t-else="" class="d-none d-lg-block" t-field="a.name"/>
        </xpath>
    </template>

    <!-- 1. Thẻ sản phẩm /shop: Tag động (tối đa 2), Highlight, Tồn kho & Giá gạch + Badge -XX% -->
    <template
        id="gift_products_item"
        inherit_id="website_sale.products_item"
        name="WBH Gift Store Product Card"
        priority="20"
    >
        <xpath expr="//div[hasclass('o_wsale_product_information_text')]" position="inside">
            <t t-if="website and website.wbh_store_type == 'gift'">
                <t t-set="wbh_card_tags" t-value="product.product_tag_ids.filtered(lambda t: t.wbh_show_in_filter)[:2]"/>
                <div t-if="wbh_card_tags" class="wbh-gift-card-tags d-flex flex-wrap gap-1 mb-1">
                    <span
                        t-foreach="wbh_card_tags"
                        t-as="card_tag"
                        class="wbh-gift-card-tag"
                    >
                        <span
                            t-if="card_tag.wbh_badge_hex"
                            class="wbh-tag-dot"
                            t-att-data-wbh-dot-color="card_tag.wbh_badge_hex"
                            aria-hidden="true"
                        />
                        <span t-out="card_tag.name"/>
                    </span>
                </div>
                <p
                    t-if="product.wbh_short_highlight"
                    class="wbh-gift-card-highlight small mb-1"
                    t-field="product.wbh_short_highlight"
                />
                <div class="wbh-gift-card-stock mt-1">
                    <t t-if="product.is_storable and product.sudo().qty_available &lt;= 0">
                        <span class="wbh-gift-stock-badge wbh-gift-stock-badge--out">
                            <i data-lucide="clock" class="wbh-lucide-icon" aria-hidden="true"/><span>Hết hàng</span>
                        </span>
                    </t>
                    <t t-elif="product.wbh_is_low_stock">
                        <span class="wbh-gift-stock-badge wbh-gift-stock-badge--low">
                            <i data-lucide="zap" class="wbh-lucide-icon" aria-hidden="true"/><span>Sắp hết</span>
                        </span>
                    </t>
                    <t t-else="">
                        <span class="wbh-gift-stock-badge wbh-gift-stock-badge--in">
                            <i data-lucide="check-circle-2" class="wbh-lucide-icon" aria-hidden="true"/><span>Sẵn hàng</span>
                        </span>
                    </t>
                </div>
            </t>
        </xpath>

        <!-- Giá gạch compare_list_price (khi core chưa render base_price) + huy hiệu -XX% -->
        <xpath expr="//div[hasclass('product_price')]" position="inside">
            <t t-if="website and website.wbh_store_type == 'gift'">
                <t t-set="wbh_price_map" t-value="template_price_vals or {}"/>
                <t t-set="wbh_has_compare" t-value="bool(product.compare_list_price and product.list_price and product.compare_list_price &gt; product.list_price)"/>
                <t t-set="wbh_core_has_base" t-value="bool('base_price' in wbh_price_map and (wbh_price_map.get('base_price') or 0) &gt; (wbh_price_map.get('price_reduce') or 0))"/>
                <del
                    t-if="wbh_has_compare and not wbh_core_has_base"
                    aria-label="Giá gốc"
                    class="wbh-gift-compare-price text-muted small mb-0 text-nowrap"
                >
                    <span
                        t-out="product.compare_list_price"
                        t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"
                    />
                </del>
                <span
                    t-if="wbh_has_compare and product.wbh_discount_percent and product.wbh_discount_percent &gt; 0"
                    class="wbh-gift-discount-badge"
                >
                    -<t t-out="product.wbh_discount_percent"/>%
                </span>
            </t>
        </xpath>
    </template>

    <!-- 2. Trang /shop: Sidebar lọc động, Chips đang lọc, Nút Bộ lọc mobile >= 44px -->
    <template
        id="gift_shop_filters_and_chips"
        inherit_id="website_sale.products"
        name="WBH Gift Store Dynamic Shop Filters"
        priority="20"
    >
        <!-- Sidebar Desktop -->
        <xpath expr="//aside[@id='products_grid_before']//div[contains(@t-attf-class, 'products_attributes_filters')]" position="before">
            <t t-if="website and website.wbh_store_type == 'gift'">
                <t t-call="theme_gift_store.gift_dynamic_filters_panel">
                    <t t-set="wbh_filter_mobile" t-value="False"/>
                </t>
            </t>
        </xpath>

        <!-- Thanh Active Filter Chips phía trên lưới sản phẩm -->
        <xpath expr="//header[@id='o_wsale_products_header']" position="after">
            <t t-if="website and website.wbh_store_type == 'gift'">
                <t t-set="wbh_fctx" t-value="wbh_filter_ctx or {}"/>
                <t t-set="wbh_chips" t-value="wbh_fctx.get('active_chips') or []"/>
                <div
                    t-if="wbh_chips"
                    class="wbh-gift-active-chips d-flex flex-wrap align-items-center gap-2 mb-3"
                    role="region"
                    aria-label="Bộ lọc đang áp dụng"
                >
                    <a
                        t-foreach="wbh_chips"
                        t-as="chip"
                        t-att-href="chip.get('remove_url', '/shop')"
                        t-attf-class="wbh-gift-chip wbh-gift-chip--{{chip.get('kind', 'other')}}"
                        t-attf-aria-label="Bỏ lọc {{chip.get('label', '')}}"
                    >
                        <span class="wbh-gift-chip__label" t-out="chip.get('label')"/>
                        <i data-lucide="x" class="wbh-lucide-icon wbh-gift-chip__close" aria-hidden="true"/>
                    </a>
                    <a
                        t-att-href="wbh_fctx.get('clear_all_url', '/shop')"
                        class="wbh-gift-chip-clear"
                    >
                        Xóa tất cả
                    </a>
                </div>
            </t>
        </xpath>

        <!-- Nút Bộ lọc mobile >= 44px kèm số bộ lọc đang bật -->
        <xpath expr="//div[hasclass('products_header')]//button[@data-bs-target='#o_wsale_offcanvas']" position="after">
            <t t-if="website and website.wbh_store_type == 'gift' and wsale_has_filters_btn">
                <t t-set="wbh_fctx" t-value="wbh_filter_ctx or {}"/>
                <t t-set="wbh_active_count" t-value="wbh_fctx.get('total_active_filters', 0) or 0"/>
                <button
                    type="button"
                    t-attf-class="btn wbh-gift-btn-outline wbh-mobile-filter-btn position-relative {{not wsale_has_filters_btn_lg and 'd-lg-none'}} text-nowrap"
                    title="Bộ lọc"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#o_wsale_offcanvas"
                >
                    <i data-lucide="sliders-horizontal" class="wbh-lucide-icon" aria-hidden="true"/>
                    <span>Bộ lọc</span>
                    <span
                        t-if="wbh_active_count &gt; 0"
                        class="wbh-mobile-filter-badge"
                        t-out="wbh_active_count"
                    />
                </button>
            </t>
        </xpath>
    </template>

    <!-- 2B. Mobile Offcanvas Drawer: Bộ lọc động & Nút Xóa bộ lọc -->
    <template
        id="gift_shop_offcanvas_filters"
        inherit_id="website_sale.o_wsale_offcanvas"
        name="WBH Gift Store Offcanvas Dynamic Filters"
        priority="20"
    >
        <xpath expr="//div[@id='o_wsale_offcanvas_content']/div[1]" position="before">
            <t t-if="website and website.wbh_store_type == 'gift'">
                <t t-call="theme_gift_store.gift_dynamic_filters_panel">
                    <t t-set="wbh_filter_mobile" t-value="True"/>
                </t>
            </t>
        </xpath>
        <xpath expr="//aside[@id='o_wsale_offcanvas']/div[last()]" position="inside">
            <t t-if="website and website.wbh_store_type == 'gift'">
                <t t-set="wbh_fctx" t-value="wbh_filter_ctx or {}"/>
                <a
                    t-if="(wbh_fctx.get('total_active_filters', 0) or 0) &gt; 0"
                    t-att-href="wbh_fctx.get('clear_all_url', '/shop')"
                    class="btn wbh-gift-btn-outline w-100 wbh-gift-offcanvas-clear"
                >
                    Xóa tất cả bộ lọc
                </a>
            </t>
        </xpath>
    </template>

    <!-- 3. Tiêu đề trang chi tiết: badge wbh_short_highlight & Extension Slot so sánh kích thước -->
    <template
        id="gift_product_title"
        inherit_id="website_sale.product_title"
        name="WBH Gift Store Product Title &amp; Highlight"
        priority="20"
    >
        <xpath expr="//h1" position="after">
            <div
                t-if="website and website.wbh_store_type == 'gift' and product.wbh_short_highlight"
                class="wbh-gift-highlight-badge mb-3"
            >
                <i data-lucide="sparkles" class="wbh-lucide-icon me-2" aria-hidden="true"/>
                <span t-field="product.wbh_short_highlight"/>
            </div>
        </xpath>

        <xpath expr="//div[@t-field='product.description_ecommerce']" position="after">
            <!-- Extension Slot M2: Khối So sánh kích thước trực quan cạnh vật mẫu (wbh_gift_store) -->
            <div
                t-if="website and website.wbh_store_type == 'gift'"
                id="wbh_gift_size_compare_slot"
                class="wbh-ext-slot"
            />
        </xpath>
    </template>

    <!-- 3B. PDP Giá gạch compare_list_price & Huy hiệu -XX% (không trùng với core) -->
    <template
        id="gift_product_price_discount"
        inherit_id="website_sale.product_price"
        name="WBH Gift Store PDP Price Discount"
        priority="20"
    >
        <xpath expr="//div[@name='product_price_container']" position="inside">
            <t t-if="website and website.wbh_store_type == 'gift'">
                <t t-set="wbh_comb" t-value="combination_info or {}"/>
                <t t-set="wbh_has_compare" t-value="bool(product.compare_list_price and product.list_price and product.compare_list_price &gt; product.list_price)"/>
                <t t-set="wbh_core_strike" t-value="bool(wbh_comb.get('has_discounted_price') or (wbh_comb.get('compare_list_price') and (wbh_comb.get('compare_list_price') or 0) &gt; (wbh_comb.get('price') or 0)))"/>
                <del
                    t-if="wbh_has_compare and not wbh_core_strike"
                    name="wbh_product_price_strikethrough"
                    aria-label="Giá gốc"
                    class="wbh-gift-compare-price text-muted ms-1 h6 mb-0"
                >
                    <bdi dir="inherit">
                        <span
                            t-out="product.compare_list_price"
                            t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"
                        />
                    </bdi>
                </del>
                <span
                    t-if="wbh_has_compare and product.wbh_discount_percent and product.wbh_discount_percent &gt; 0"
                    class="wbh-gift-discount-badge wbh-gift-discount-badge--pdp"
                >
                    -<t t-out="product.wbh_discount_percent"/>%
                </span>
            </t>
        </xpath>
    </template>

    <!-- 3C. PDP Chính sách bán hàng 4 dòng riêng của Manh Dao Dao (thay block Terms mặc định) -->
    <template
        id="gift_product_terms_and_conditions"
        inherit_id="website_sale.product_terms_and_conditions"
        name="WBH Gift Store Product Policy 4 Lines"
        priority="25"
    >
        <xpath expr="//small" position="replace">
            <ul
                t-if="website and website.wbh_store_type == 'gift'"
                class="wbh-gift-pdp-policies list-unstyled mb-0 small"
            >
                <li class="d-flex align-items-start gap-2">
                    <i data-lucide="file-text" class="wbh-lucide-icon mt-1" aria-hidden="true"/>
                    <span>Hàng mddf, df nặng sẽ note</span>
                </li>
                <li class="d-flex align-items-start gap-2">
                    <i data-lucide="calendar" class="wbh-lucide-icon mt-1" aria-hidden="true"/>
                    <span>Đi đơn vào chủ nhật hàng tuần</span>
                </li>
                <li class="d-flex align-items-start gap-2">
                    <i data-lucide="video" class="wbh-lucide-icon mt-1" aria-hidden="true"/>
                    <span>Quay video khi unbox, chỉ giải quyết khi có video</span>
                </li>
                <li class="d-flex align-items-start gap-2">
                    <i data-lucide="truck" class="wbh-lucide-icon mt-1" aria-hidden="true"/>
                    <span>Đvvc: Viettel Post</span>
                </li>
            </ul>
            <small t-else="" class="text-muted mb-0">
                <a href="/terms" class="o_translate_inline text-muted"><u>Terms and Conditions</u></a><br/>
                30-day money-back guarantee<br/>
                Shipping: 2-3 Business Days
            </small>
        </xpath>
    </template>

    <!-- 4. Trang chi tiết sản phẩm: Extension Slots, Hộp Tư vấn & Sticky Mobile Bar (đã xóa khối gập lưu ý quà tặng) -->
    <template
        id="gift_product_detail"
        inherit_id="website_sale.product"
        name="WBH Gift Store Product Detail"
        priority="20"
    >
        <!-- Extension Slot M3: Banner đồng hồ đếm ngược Flash Sale đặt ngay trên giá sản phẩm -->
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_price')]" position="before">
            <div
                t-if="website and website.wbh_store_type == 'gift'"
                id="wbh_flash_sale_banner_slot"
                class="wbh-ext-slot"
            />
        </xpath>

        <!-- Extension Slot M2: Widget Gói quà + Thiệp & Cá nhân hóa đặt ngay trên nút Thêm vào giỏ -->
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_cta')]" position="before">
            <div
                t-if="website and website.wbh_store_type == 'gift'"
                id="wbh_gift_options_slot"
                class="wbh-ext-slot"
            />
        </xpath>

        <!-- Hộp Tư vấn Web 1 đặt ngay dưới CTA -->
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_cta')]" position="after">
            <t t-if="website and website.wbh_store_type == 'gift'">
                <t t-call="theme_gift_store.gift_contact_channels_box">
                    <t t-set="wbh_contact_item_title" t-value="product.name"/>
                    <t t-set="wbh_contact_mode" t-value="'pdp'"/>
                </t>
            </t>
        </xpath>

        <!-- Thanh Sticky Bottom Bar trên Mobile: hiển thị giá + nút Thêm vào giỏ 1 chạm -->
        <xpath expr="//section[@id='product_detail']" position="after">
            <div
                t-if="website and website.wbh_store_type == 'gift' and is_add_to_cart_possible and not (combination_info and combination_info.get('prevent_zero_price_sale'))"
                class="wbh-gift-sticky-bar d-lg-none"
                role="region"
                aria-label="Thanh mua nhanh trên di động"
            >
                <div class="container d-flex align-items-center justify-content-between gap-3">
                    <div class="wbh-gift-sticky-bar__info min-w-0">
                        <div class="wbh-gift-sticky-bar__name text-truncate small" t-out="product.name"/>
                        <div
                            class="wbh-gift-sticky-bar__price fw-bold"
                            t-out="(combination_info or {}).get('price', product.list_price)"
                            t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"
                        />
                    </div>
                    <button
                        type="button"
                        class="btn wbh-gift-btn-primary wbh-gift-sticky-bar__btn flex-shrink-0"
                        data-wbh-trigger-cart="true"
                    >
                        <i data-lucide="shopping-cart" class="wbh-lucide-icon" aria-hidden="true"/>
                        <span>Thêm vào giỏ</span>
                    </button>
                </div>
            </div>
        </xpath>
    </template>

    <!-- 5. Giỏ hàng (/shop/cart): Thanh Tư vấn trước khi đặt -->
    <template
        id="gift_cart_consultation"
        inherit_id="website_sale.cart"
        name="WBH Gift Store Cart Consultation Bar"
        priority="20"
    >
        <xpath expr="//div[@id='oe_structure_website_sale_cart_1']" position="before">
            <t t-if="website and website.wbh_store_type == 'gift'">
                <t
                    t-set="wbh_cart_summary_title"
                    t-value="', '.join(website_sale_order.website_order_line.mapped('product_id.name')[:3]) if website_sale_order and website_sale_order.website_order_line else 'Giỏ hàng của tôi'"
                />
                <t t-call="theme_gift_store.gift_contact_channels_box">
                    <t t-set="wbh_contact_item_title" t-value="wbh_cart_summary_title"/>
                    <t t-set="wbh_contact_mode" t-value="'cart'"/>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
