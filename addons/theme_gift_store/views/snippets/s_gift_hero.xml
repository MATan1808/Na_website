<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_gift_hero" name="Hero Manh Dao Dao Anime Goods">
        <section
            class="s_gift_hero o_colored_level pt48 pb48"
            data-snippet="s_gift_hero"
            data-name="Hero Manh Dao Dao"
        >
            <div class="container">
                <div class="row align-items-center g-4 g-lg-5">
                    <div class="col-lg-6">
                        <p class="wbh-gift-kicker mb-2">
                            Manh Dao Dao . Boku no Hero Academia Anime Goods Shop
                        </p>
                        <h1 class="wbh-gift-hero__title fw-semibold mb-3">
                            Doll và các loại goods Boku no Hero, hàng sẵn giao ngay
                        </h1>
                        <p class="wbh-gift-hero__lead mb-4">
                            Gồm doll, card các loại, postcard (pc), clear file, bookmark, standee, key, badge...
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <a href="/shop" class="btn btn-lg wbh-gift-btn-primary">
                                <span>Xem bộ sưu tập</span>
                                <i data-lucide="arrow-right" class="wbh-lucide-icon" aria-hidden="true"/>
                            </a>
                        </div>
                        <div class="wbh-gift-hero__trust d-flex flex-wrap gap-4 mt-4 pt-2">
                            <div class="d-flex align-items-center gap-2">
                                <i data-lucide="shield-check" class="wbh-lucide-icon wbh-gift-icon-accent" aria-hidden="true"/>
                                <span>Ảnh chụp sản phẩm thật</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <i data-lucide="package-check" class="wbh-lucide-icon wbh-gift-icon-accent" aria-hidden="true"/>
                                <span>Gói an toàn, chống sốc kỹ</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="wbh-gift-hero__showcase">
                            <div class="row g-3">
                                <div class="col-7">
                                    <a href="/shop?search=Doll" class="wbh-gift-hero__gallery-item d-block text-decoration-none h-100">
                                        <div class="wbh-gift-hero__photo-frame wbh-gift-hero__photo-frame--tall">
                                            <img src="/wbh_core/static/src/img/anime_goods/bakugo_doll_fullset.jpg" alt="Cotton Doll 20cm Bakugo Katsuki Boku no Hero Academia" loading="eager"/>
                                        </div>
                                        <div class="wbh-gift-hero__caption mt-2">
                                            <span class="wbh-gift-hero__caption-title d-block">Doll &amp; Outfit</span>
                                            <span class="wbh-gift-hero__caption-sub">Boku no Hero Academia sẵn hàng</span>
                                        </div>
                                    </a>
                                </div>
                                <div class="col-5 d-flex flex-column gap-3">
                                    <a href="/shop?search=Card" class="wbh-gift-hero__gallery-item d-block text-decoration-none">
                                        <div class="wbh-gift-hero__photo-frame">
                                            <img src="/wbh_core/static/src/img/anime_goods/todoroki_goods_collection.jpg" alt="Card, Postcard và Badge Todoroki Shoto" loading="eager"/>
                                        </div>
                                        <div class="wbh-gift-hero__caption mt-2">
                                            <span class="wbh-gift-hero__caption-title d-block">Card &amp; Badge</span>
                                            <span class="wbh-gift-hero__caption-sub">Card, postcard (pc), huy hiệu</span>
                                        </div>
                                    </a>
                                    <a href="/shop" class="wbh-gift-hero__gallery-item d-block text-decoration-none">
                                        <div class="wbh-gift-hero__photo-frame">
                                            <img src="/wbh_core/static/src/img/anime_goods/bakugo_poster.jpg" alt="Standee, Clear File và Poster Boku no Hero" loading="eager"/>
                                        </div>
                                        <div class="wbh-gift-hero__caption mt-2">
                                            <span class="wbh-gift-hero__caption-title d-block">Standee &amp; Clear File</span>
                                            <span class="wbh-gift-hero__caption-sub">Bookmark, key, goods sưu tầm</span>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
