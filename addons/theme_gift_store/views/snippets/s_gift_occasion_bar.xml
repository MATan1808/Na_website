<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_gift_occasion_bar" name="Thanh Chọn Nhanh Goods Boku no Hero">
        <section
            class="s_gift_occasion_bar o_colored_level pt40 pb40"
            data-snippet="s_gift_occasion_bar"
            data-name="Thanh Chọn Nhanh Goods"
        >
            <div class="container">
                <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
                    <div>
                        <h2 class="h4 fw-semibold mb-1">Nhóm goods Boku no Hero</h2>
                        <p class="wbh-gift-subtext mb-0">Chọn nhanh loại goods bạn đang tìm trong bộ sưu tập</p>
                    </div>
                </div>
                <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-6">
                    <div class="col">
                        <a href="/shop?search=Card" class="wbh-gift-occasion-card d-flex flex-column align-items-center text-center p-3 h-100 text-decoration-none">
                            <span class="wbh-gift-occasion-card__icon mb-2">
                                <i data-lucide="layers" class="wbh-lucide-icon" aria-hidden="true"/>
                            </span>
                            <span class="wbh-gift-occasion-card__label">Card &amp; Postcard</span>
                        </a>
                    </div>
                    <div class="col">
                        <a href="/shop?search=Doll" class="wbh-gift-occasion-card d-flex flex-column align-items-center text-center p-3 h-100 text-decoration-none">
                            <span class="wbh-gift-occasion-card__icon mb-2">
                                <i data-lucide="smile" class="wbh-lucide-icon" aria-hidden="true"/>
                            </span>
                            <span class="wbh-gift-occasion-card__label">Doll</span>
                        </a>
                    </div>
                    <div class="col">
                        <a href="/shop?search=Standee" class="wbh-gift-occasion-card d-flex flex-column align-items-center text-center p-3 h-100 text-decoration-none">
                            <span class="wbh-gift-occasion-card__icon mb-2">
                                <i data-lucide="sparkles" class="wbh-lucide-icon" aria-hidden="true"/>
                            </span>
                            <span class="wbh-gift-occasion-card__label">Standee &amp; Figure</span>
                        </a>
                    </div>
                    <div class="col">
                        <a href="/shop?search=Badge" class="wbh-gift-occasion-card d-flex flex-column align-items-center text-center p-3 h-100 text-decoration-none">
                            <span class="wbh-gift-occasion-card__icon mb-2">
                                <i data-lucide="badge-check" class="wbh-lucide-icon" aria-hidden="true"/>
                            </span>
                            <span class="wbh-gift-occasion-card__label">Badge</span>
                        </a>
                    </div>
                    <div class="col">
                        <a href="/shop?search=Key" class="wbh-gift-occasion-card d-flex flex-column align-items-center text-center p-3 h-100 text-decoration-none">
                            <span class="wbh-gift-occasion-card__icon mb-2">
                                <i data-lucide="key-round" class="wbh-lucide-icon" aria-hidden="true"/>
                            </span>
                            <span class="wbh-gift-occasion-card__label">Key &amp; Clear File</span>
                        </a>
                    </div>
                    <div class="col">
                        <a href="/shop" class="wbh-gift-occasion-card d-flex flex-column align-items-center text-center p-3 h-100 text-decoration-none">
                            <span class="wbh-gift-occasion-card__icon mb-2">
                                <i data-lucide="grid-2x2" class="wbh-lucide-icon" aria-hidden="true"/>
                            </span>
                            <span class="wbh-gift-occasion-card__label">Tất cả goods</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
