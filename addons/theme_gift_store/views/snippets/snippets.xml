<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Đăng ký 3 Building Blocks của Web 1 vào Website Builder (Odoo 19.0) -->
    <template id="gift_snippets" inherit_id="website.snippets" name="WBH Gift Store Snippets">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="theme_gift_store.s_gift_hero" string="Hero Quà Tặng" group="intro">
                <keywords>quà tặng, gift, hero, banner, gấu bông, móc khóa, blind box</keywords>
            </t>
            <t t-snippet="theme_gift_store.s_gift_occasion_bar" string="Thanh Chọn Quà Theo Dịp" group="columns">
                <keywords>quà tặng, dịp lễ, sinh nhật, valentine, combo, danh mục, occasion</keywords>
            </t>
            <t t-snippet="theme_gift_store.s_gift_featured_grid" string="Lưới Quà Tặng Nổi Bật" group="catalog">
                <keywords>quà tặng, sản phẩm nổi bật, gấu bông, móc khóa, blind box, grid</keywords>
            </t>
        </xpath>
    </template>
</odoo>
