<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Kế thừa website.layout theo chuẩn Multi-Website Odoo 19.0:
        - Nạp Google Fonts Be Vietnam Pro & Quicksand có điều kiện chỉ cho Web 1.
        - Gắn class động .wbh-store-gift lên #wrapwrap chỉ khi website.wbh_store_type == 'gift'.
        - Mọi khối thông báo đầu trang và dải hỗ trợ chân trang đều khóa chặt trong
          t-if="website and website.wbh_store_type == 'gift'" và đặt ngoài vùng editable #footer
          để tuyệt đối không rò rỉ sang Web 2 và không xung đột Website Builder.
    -->
    <template id="gift_layout_scope" inherit_id="website.layout" name="WBH Gift Store Layout Scope" priority="20">
        <!-- Nạp font tiếng Việt Be Vietnam Pro & Quicksand chỉ trên Web 1 -->
        <xpath expr="//head" position="inside">
            <t t-if="website and website.wbh_store_type == 'gift'">
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
                <meta name="theme-color" content="#FF6B8B"/>
                <link
                    rel="stylesheet"
                    href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&amp;family=Quicksand:wght@500;600;700&amp;display=swap"
                />
            </t>
        </xpath>

        <!-- Gắn class nhận diện Web 1 lên #wrapwrap -->
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute
                name="t-attf-class"
                add="{{'wbh-store-gift' if website and website.wbh_store_type == 'gift' else ''}}"
                separator=" "
            />
        </xpath>

        <!-- Thanh thông báo thương hiệu & liên hệ nhanh riêng Web 1 phía trên Header -->
        <xpath expr="//header[@id='top']" position="before">
            <div
                t-if="not no_header and website and website.wbh_store_type == 'gift'"
                class="wbh-gift-topbar o_not_editable d-print-none"
                role="region"
                aria-label="Thông tin cửa hàng quà tặng"
            >
                <div class="container d-flex flex-nowrap align-items-center justify-content-between gap-2 py-2">
                    <div class="wbh-gift-topbar__tagline d-none d-sm-flex align-items-center gap-2 text-truncate">
                        <i data-lucide="gift" class="wbh-lucide-icon" aria-hidden="true"/>
                        <span t-if="website.wbh_brand_tagline" t-field="website.wbh_brand_tagline"/>
                        <span t-else="">Chuyên Cotton Doll 20cm &amp; Anime Goods</span>
                    </div>
                    <div class="wbh-gift-topbar__contacts d-flex flex-nowrap align-items-center justify-content-between justify-content-sm-end gap-2 gap-sm-3 w-100 w-sm-auto">
                        <a
                            t-if="website.wbh_support_hotline"
                            t-attf-href="tel:{{website.wbh_support_hotline.replace(' ', '')}}"
                            class="wbh-gift-topbar__link text-nowrap d-inline-flex align-items-center gap-1"
                        >
                            <i data-lucide="phone" class="wbh-lucide-icon" aria-hidden="true"/>
                            <span t-out="website.wbh_support_hotline"/>
                        </a>
                        <a
                            t-if="website.wbh_support_zalo_url"
                            t-att-href="website.wbh_support_zalo_url"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="wbh-gift-topbar__zalo text-nowrap d-inline-flex align-items-center gap-1"
                        >
                            <i data-lucide="message-circle" class="wbh-lucide-icon" aria-hidden="true"/>
                            <span>Zalo CSKH</span>
                        </a>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- Dải hỗ trợ & điều hướng thương hiệu riêng Web 1 đặt trước #footer (trên nút scrolltop) -->
        <xpath expr="//div[@id='footer']" position="before">
            <section
                t-if="not no_footer and website and website.wbh_store_type == 'gift'"
                class="wbh-gift-footer-band o_not_editable o_colored_level pt32 pb40"
                data-snippet="s_gift_footer_band"
                data-name="Chân Trang Quà Tặng"
            >
                <div class="container">
                    <div class="row g-4 align-items-center">
                        <div class="col-lg-5">
                            <h5 class="wbh-gift-footer-band__title mb-2" t-out="website.name"/>
                            <p class="wbh-gift-footer-band__desc mb-0">
                                <t t-if="website.wbh_brand_tagline" t-out="website.wbh_brand_tagline"/>
                                <t t-else="">Chuyên gấu bông, móc khóa, Blind Box và combo quà tặng theo dịp — gói quà chỉn chu, giao nhanh toàn quốc.</t>
                            </p>
                        </div>
                        <div class="col-lg-4">
                            <h6 class="wbh-gift-footer-band__heading mb-2">Khám phá nhanh</h6>
                            <ul class="list-inline mb-0 wbh-gift-footer-band__links">
                                <li class="list-inline-item"><a href="/shop">Tất cả quà tặng</a></li>
                                <li class="list-inline-item"><a href="/shop?search=Gấu+bông">Gấu bông</a></li>
                                <li class="list-inline-item"><a href="/shop?search=Móc+khóa">Móc khóa</a></li>
                                <li class="list-inline-item"><a href="/shop?search=Blind+Box">Blind Box</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-3 text-lg-end">
                            <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                                <a
                                    t-if="website.wbh_support_hotline"
                                    t-attf-href="tel:{{website.wbh_support_hotline.replace(' ', '')}}"
                                    class="btn btn-sm wbh-gift-btn-outline"
                                >
                                    <i data-lucide="phone" class="wbh-lucide-icon me-1" aria-hidden="true"/>
                                    <t t-out="website.wbh_support_hotline"/>
                                </a>
                                <a
                                    t-if="website.wbh_support_zalo_url"
                                    t-att-href="website.wbh_support_zalo_url"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="btn btn-sm wbh-gift-btn-primary"
                                >
                                    <i data-lucide="message-circle" class="wbh-lucide-icon me-1" aria-hidden="true"/>
                                    Zalo tư vấn quà
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>

        <!-- Thay thế dòng bản quyền cứng 'Company name' bằng tên Website/Công ty thực tế -->
        <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
            <span class="o_footer_copyright_name me-2 small">
                <t t-if="website and website.wbh_store_type in ('gift', 'fashion')">
                    Bản quyền &amp;copy; <t t-out="website.name"/>
                </t>
                <t t-else="">Bản quyền &amp;copy; <span t-field="res_company.name"/></t>
            </span>
        </xpath>

        <!-- Widget Liên hệ nổi 3 trong 1 + Toast thông báo (riêng Web 1, tránh đè scrolltop và sticky bar) -->
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <t t-if="website and website.wbh_store_type == 'gift'">
                <t t-set="wbh_has_any_contact" t-value="website.wbh_livechat_enabled or website.wbh_fb_messenger_url or website.wbh_support_zalo_url or website.wbh_support_hotline"/>
                <div
                    t-if="wbh_has_any_contact"
                    class="wbh-gift-floating-contact o_not_editable d-print-none"
                    data-wbh-floating-root="true"
                >
                    <div
                        id="wbhGiftFloatingMenu"
                        class="wbh-gift-floating-menu"
                        role="menu"
                        aria-label="Kênh tư vấn nhanh"
                        hidden="hidden"
                    >
                        <button
                            t-if="website.wbh_livechat_enabled"
                            type="button"
                            class="wbh-gift-floating-item wbh-gift-floating-item--livechat"
                            role="menuitem"
                            data-wbh-action="livechat"
                            t-att-data-wbh-product-name="website.name"
                        >
                            <i data-lucide="message-square" class="wbh-lucide-icon" aria-hidden="true"/>
                            <span>Chat tại Web</span>
                        </button>
                        <a
                            t-if="website.wbh_fb_messenger_url"
                            t-att-href="website.wbh_fb_messenger_url"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="wbh-gift-floating-item wbh-gift-floating-item--fb"
                            role="menuitem"
                        >
                            <i data-lucide="send" class="wbh-lucide-icon" aria-hidden="true"/>
                            <span>Nhắn Facebook</span>
                        </a>
                        <a
                            t-if="website.wbh_support_zalo_url"
                            t-att-href="website.wbh_support_zalo_url"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="wbh-gift-floating-item wbh-gift-floating-item--zalo"
                            role="menuitem"
                        >
                            <i data-lucide="message-circle" class="wbh-lucide-icon" aria-hidden="true"/>
                            <span>Nhắn Zalo</span>
                        </a>
                        <a
                            t-if="website.wbh_support_hotline"
                            t-attf-href="tel:{{website.wbh_support_hotline.replace(' ', '')}}"
                            class="wbh-gift-floating-item"
                            role="menuitem"
                        >
                            <i data-lucide="phone" class="wbh-lucide-icon" aria-hidden="true"/>
                            <span t-out="website.wbh_support_hotline"/>
                        </a>
                    </div>
                    <button
                        type="button"
                        class="wbh-gift-floating-fab"
                        data-wbh-floating-toggle="true"
                        aria-expanded="false"
                        aria-controls="wbhGiftFloatingMenu"
                        aria-label="Mở kênh tư vấn nhanh"
                    >
                        <i data-lucide="messages-square" class="wbh-lucide-icon wbh-gift-floating-fab__icon-open" aria-hidden="true"/>
                        <i data-lucide="x" class="wbh-lucide-icon wbh-gift-floating-fab__icon-close" aria-hidden="true"/>
                        <span class="wbh-gift-floating-fab__label d-none d-md-inline">Tư vấn</span>
                    </button>
                </div>

                <div
                    id="wbhGiftToast"
                    class="wbh-gift-toast o_not_editable d-print-none"
                    role="status"
                    aria-live="polite"
                    hidden="hidden"
                />
            </t>
        </xpath>
    </template>
</odoo>
