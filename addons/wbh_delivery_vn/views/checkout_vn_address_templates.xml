<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bổ sung bộ chọn địa giới hành chính Việt Nam 3 cấp trên form /shop/address -->
    <template id="checkout_vn_address_form_fields"
              name="WBH VN 3-Level Address Fields"
              inherit_id="website_sale.address_form_fields"
              priority="25">
        <xpath expr="//div[@id='div_state']" position="after">
            <t t-set="wbh_provinces"
               t-value="request.env['wbh.vn.province'].sudo().search([('active', '=', True)], order='sequence, name, id')"/>
            <t t-set="wbh_selected_province_id"
               t-value="partner_sudo.wbh_vn_province_id.id if partner_sudo and partner_sudo.wbh_vn_province_id else False"/>
            <t t-set="wbh_selected_district_id"
               t-value="partner_sudo.wbh_vn_district_id.id if partner_sudo and partner_sudo.wbh_vn_district_id else False"/>
            <t t-set="wbh_selected_ward_id"
               t-value="partner_sudo.wbh_vn_ward_id.id if partner_sudo and partner_sudo.wbh_vn_ward_id else False"/>
            <t t-set="wbh_districts"
               t-value="request.env['wbh.vn.district'].sudo().search([('province_id', '=', wbh_selected_province_id), ('active', '=', True)], order='sequence, name, id') if wbh_selected_province_id else request.env['wbh.vn.district']"/>
            <t t-set="wbh_wards"
               t-value="request.env['wbh.vn.ward'].sudo().search([('district_id', '=', wbh_selected_district_id), ('active', '=', True)], order='sequence, name, id') if wbh_selected_district_id else request.env['wbh.vn.ward']"/>

            <div class="w-100 wbh-vn-address-field"/>
            <div id="div_wbh_vn_province" class="col-12 col-md-4 mb-2 wbh-vn-address-field">
                <label class="col-form-label label-optional" for="o_wbh_vn_province_id">
                    Tỉnh / Thành phố (VN)
                </label>
                <select id="o_wbh_vn_province_id"
                        name="wbh_vn_province_id"
                        class="form-select wbh-vn-select">
                    <option value="">Chọn Tỉnh / Thành phố...</option>
                    <t t-foreach="wbh_provinces" t-as="prov">
                        <option t-att-value="prov.id"
                                t-att-selected="prov.id == wbh_selected_province_id"
                                t-out="prov.name"/>
                    </t>
                </select>
            </div>
            <div id="div_wbh_vn_district" class="col-12 col-md-4 mb-2 wbh-vn-address-field">
                <label class="col-form-label label-optional" for="o_wbh_vn_district_id">
                    Quận / Huyện
                </label>
                <select id="o_wbh_vn_district_id"
                        name="wbh_vn_district_id"
                        class="form-select wbh-vn-select"
                        t-att-disabled="'disabled' if not wbh_selected_province_id else None">
                    <option value="">Chọn Quận / Huyện...</option>
                    <t t-foreach="wbh_districts" t-as="dist">
                        <option t-att-value="dist.id"
                                t-att-selected="dist.id == wbh_selected_district_id"
                                t-out="dist.name"/>
                    </t>
                </select>
            </div>
            <div id="div_wbh_vn_ward" class="col-12 col-md-4 mb-2 wbh-vn-address-field">
                <label class="col-form-label label-optional" for="o_wbh_vn_ward_id">
                    Phường / Xã
                </label>
                <select id="o_wbh_vn_ward_id"
                        name="wbh_vn_ward_id"
                        class="form-select wbh-vn-select"
                        t-att-disabled="'disabled' if not wbh_selected_district_id else None">
                    <option value="">Chọn Phường / Xã...</option>
                    <t t-foreach="wbh_wards" t-as="ward">
                        <option t-att-value="ward.id"
                                t-att-selected="ward.id == wbh_selected_ward_id"
                                t-out="ward.name"/>
                    </t>
                </select>
            </div>
        </xpath>
    </template>

    <!-- Hiển thị huy hiệu Gom đơn 0đ & mô tả vận chuyển tại bước chọn phương thức giao hàng -->
    <template id="checkout_delivery_method_wbh_vn"
              name="WBH VN Delivery Method Badges"
              inherit_id="website_sale.delivery_method"
              priority="25">
        <xpath expr="//span[@name='o_delivery_method_name']" position="after">
            <span t-if="dm.wbh_is_hold_order"
                  class="badge rounded-pill text-bg-info ms-2 wbh-hold-order-badge">
                Gom đơn 0đ
            </span>
        </xpath>
        <xpath expr="//div[@t-field='dm.website_description']" position="after">
            <div t-if="dm.wbh_provider_note"
                 t-field="dm.wbh_provider_note"
                 class="text-muted small mt-1"/>
        </xpath>
    </template>
</odoo>
