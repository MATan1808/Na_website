<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="wbh_vn_province_public_rule" model="ir.rule">
            <field name="name">WBH VN Province: Public/Portal chỉ đọc bản ghi đang kích hoạt</field>
            <field name="model_id" ref="model_wbh_vn_province"/>
            <field name="domain_force">[('active', '=', True)]</field>
            <field name="groups" eval="[
                Command.link(ref('base.group_public')),
                Command.link(ref('base.group_portal')),
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="wbh_vn_district_public_rule" model="ir.rule">
            <field name="name">WBH VN District: Public/Portal chỉ đọc bản ghi đang kích hoạt</field>
            <field name="model_id" ref="model_wbh_vn_district"/>
            <field name="domain_force">[('active', '=', True), ('province_id.active', '=', True)]</field>
            <field name="groups" eval="[
                Command.link(ref('base.group_public')),
                Command.link(ref('base.group_portal')),
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="wbh_vn_ward_public_rule" model="ir.rule">
            <field name="name">WBH VN Ward: Public/Portal chỉ đọc bản ghi đang kích hoạt</field>
            <field name="model_id" ref="model_wbh_vn_ward"/>
            <field name="domain_force">[('active', '=', True), ('district_id.active', '=', True)]</field>
            <field name="groups" eval="[
                Command.link(ref('base.group_public')),
                Command.link(ref('base.group_portal')),
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
